# ==========================================
# FASTFOOD BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fastfood_db
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_WAIT_FOR_CONNECTIONS=true
# Optional: mysqld.exe and my.ini paths for starting local XAMPP MySQL automatically
# MYSQLD_PATH=C:\xampp\mysql\bin\mysqld.exe
# MYSQLD_DEFAULTS_FILE=C:\xampp\mysql\bin\my.ini

# JWT (JSON Web Token) Configuration
JWT_SECRET=fastfood_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# CORS Configuration (comma-separated origins or * for all)
CORS_ORIGIN=*
